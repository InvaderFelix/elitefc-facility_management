Table persons {
  Note: 'Represents a person within the system. This is likely the core identity entity from which players, parents, coaches, and other roles are derived.'

  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar [not null]
  middle_name varchar
  last_name varchar [not null]
  preferred_name varchar
  date_of_birth date
  gender varchar
  identity_status varchar [not null, default: 'Pending']
  is_active boolean [not null, default: true]
  elite_id text [not null, unique, note: 'Generated external identifier using P prefix and sequence number']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table addresses {
  Note: 'Stores physical addresses separately from persons to allow reuse and historical address tracking.'

  id bigint [pk, increment]
  address_line_1 varchar [not null]
  address_line_2 varchar
  suburb varchar
  state varchar
  postcode varchar
  country varchar [not null, default: 'Australia']
  latitude numeric
  longitude numeric
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table person_addresses {
  Note: 'Associates people with addresses. Supports multiple addresses per person and historical address periods.'

  person_id uuid [not null]
  address_id bigint [not null]
  address_type varchar [not null, default: 'Home']
  is_primary boolean [not null, default: true]
  start_date date
  end_date date
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (person_id, address_id) [pk]
  }
}


Table contacts {
  Note: 'Stores contact methods independently from persons. Likely supports phone numbers, email addresses, or other contact channels.'

  id bigint [pk, increment]
  contact_type varchar [not null]
  contact_value varchar [not null]
  is_verified boolean [not null, default: false]
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Ref: person_addresses.person_id > persons.id
Ref: person_addresses.address_id > addresses.id


Table person_contacts {
  Note: 'Associates people with contact methods and stores communication preferences. Supports multiple contacts per person and historical contact relationships.'

  person_id uuid [not null]
  contact_id bigint [not null]
  contact_role varchar [default: 'Personal']
  is_primary boolean [not null, default: false]
  receives_email boolean [not null, default: true]
  receives_sms boolean [not null, default: true]
  receives_notifications boolean [not null, default: true]
  start_date date
  end_date date
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (person_id, contact_id) [pk]
  }
}


Ref: person_contacts.person_id > persons.id
Ref: person_contacts.contact_id > contacts.id


Table person_roles {
  Note: 'Assigns one or more roles to a person. Allows a single person to participate in multiple capacities (for example parent and coach).'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  role varchar [not null]
  created_at timestamptz [not null, default: `now()`]
}


Table person_identifiers {
  Note: 'Stores external identifiers associated with a person, such as government identifiers, membership numbers, or organisation-specific IDs.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  identifier_type varchar [not null]
  identifier_value varchar [not null]
  issuing_organisation varchar
  verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}


Table parent_child_relationship {
  Note: 'Defines guardianship and authority relationships between people. Both parent and child reference the persons table because they are both people entities.'

  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid [not null]
  child_id uuid [not null]
  relationship_type varchar [not null]
  is_primary_guardian boolean [not null, default: false]
  pickup_authority boolean [not null, default: false]
  medical_authority boolean [not null, default: false]
  financial_responsibility boolean [not null, default: false]
  receives_reports boolean [not null, default: true]
  receives_invoices boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}


Table emergency_contacts {
  Note: 'Stores emergency contact details for a person. Supports both existing people in the system and external contacts.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  contact_person_id uuid
  contact_name varchar
  relationship varchar
  phone varchar
  email varchar
  priority integer [not null, default: 1]
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Ref: person_roles.person_id > persons.id
Ref: person_identifiers.person_id > persons.id
Ref: parent_child_relationship.parent_id > persons.id
Ref: parent_child_relationship.child_id > persons.id
Ref: emergency_contacts.person_id > persons.id
Ref: emergency_contacts.contact_person_id > persons.id


Table player_profiles {
  Note: 'Stores football-specific attributes for a person who is a player. One profile exists per player.'

  person_id uuid [pk, not null]
  preferred_position varchar
  secondary_position varchar
  dominant_foot varchar
  previous_club varchar
  playing_since date
  height_cm integer
  weight_kg numeric
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table player_registrations {
  Note: 'Records a players registration/enrolment for a season. Multiple registrations are expected over time.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  season varchar [not null]
  registration_date date [not null, default: `CURRENT_DATE`]
  registration_status varchar [not null, default: 'Pending']
  fee_status varchar [default: 'Unpaid']
  registered_by uuid
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table player_medical {
  Note: 'Stores medical information relevant to player safety. Records may be time-bound using effective dates.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  condition varchar
  allergy varchar
  medication varchar
  requires_epipen boolean [default: false]
  medical_notes text
  effective_from date
  effective_to date
  created_at timestamptz [not null, default: `now()`]
}


Table player_consents {
  Note: 'Tracks consent decisions made for a player, including who granted consent and expiry information.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  consent_type varchar [not null]
  granted boolean [not null, default: false]
  granted_by uuid
  granted_at timestamptz
  expires_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table player_documents {
  Note: 'Stores metadata for player documents. Actual files are expected to reside in external storage.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  document_type varchar [not null]
  document_name varchar
  storage_path text
  expiry_date date
  verified boolean [not null, default: false]
  verified_by uuid
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}


Table player_injuries {
  Note: 'Tracks player injuries and recovery status over time.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  injury_type varchar [not null]
  description text
  occurred_date date
  expected_return_date date
  actual_return_date date
  status varchar [default: 'Active']
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Ref: player_profiles.person_id > persons.id
Ref: player_registrations.person_id > persons.id
Ref: player_registrations.registered_by > persons.id
Ref: player_medical.person_id > persons.id
Ref: player_consents.person_id > persons.id
Ref: player_consents.granted_by > persons.id
Ref: player_documents.person_id > persons.id
Ref: player_documents.verified_by > persons.id
Ref: player_injuries.person_id > persons.id


Table player_assessments {
  Note: 'Stores player development assessments. Each assessment is performed by another person, typically a coach or assessor.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  assessor_id uuid [not null]
  assessment_date date [not null, default: `CURRENT_DATE`]
  technical_score integer
  tactical_score integer
  physical_score integer
  mental_score integer
  comments text
  created_at timestamptz [not null, default: `now()`]
}


Table player_awards {
  Note: 'Records achievements or awards received by players.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  award_name varchar [not null]
  season varchar
  awarded_date date
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table player_photos {
  Note: 'Stores references to player photos. The actual image is expected to be stored externally, likely in Supabase Storage.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  storage_path text [not null]
  is_profile_photo boolean [default: false]
  taken_date date
  created_at timestamptz [not null, default: `now()`]
}


Table player_attendance {
  Note: 'Records player attendance at academy activities or sessions.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  session_type varchar [not null]
  session_date date [not null]
  status varchar [not null]
  arrival_time timestamptz
  departure_time timestamptz
  reason text
  created_at timestamptz [not null, default: `now()`]
}


Ref: player_assessments.person_id > persons.id
Ref: player_assessments.assessor_id > persons.id
Ref: player_awards.person_id > persons.id
Ref: player_photos.person_id > persons.id
Ref: player_attendance.person_id > persons.id


Table seasons {
  Note: 'Defines a playing or academy season. Teams and registrations may be associated with a season.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  start_date date [not null]
  end_date date [not null]
  is_current boolean [default: false]
  created_at timestamptz [not null, default: `now()`]
}


Table teams {
  Note: 'Represents a team operating within a specific season.'

  id uuid [pk, default: `gen_random_uuid()`]
  season_id uuid [not null]
  name varchar [not null]
  age_group varchar
  gender varchar
  competition varchar
  team_type varchar [default: 'Competitive']
  is_active boolean [default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table team_members {
  Note: 'Historical record of players belonging to teams. Membership is tracked over time using joined_date and left_date.'

  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null]
  person_id uuid [not null]
  joined_date date
  left_date date
  jersey_number integer
  position varchar
  membership_status varchar [default: 'Active']
  created_at timestamptz [not null, default: `now()`]
}


Table team_coaches {
  Note: 'Assigns coaches to teams over time. A person may coach multiple teams.'

  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null]
  person_id uuid [not null]
  role varchar [default: 'Head Coach']
  start_date date
  end_date date
  created_at timestamptz [not null, default: `now()`]
}


Table team_managers {
  Note: 'Assigns team managers or administrators to teams over time.'

  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null]
  person_id uuid [not null]
  role varchar [default: 'Team Manager']
  start_date date
  end_date date
  created_at timestamptz [not null, default: `now()`]
}


Ref: teams.season_id > seasons.id
Ref: team_members.team_id > teams.id
Ref: team_members.person_id > persons.id
Ref: team_coaches.team_id > teams.id
Ref: team_coaches.person_id > persons.id
Ref: team_managers.team_id > teams.id
Ref: team_managers.person_id > persons.id


Table events {
  Note: 'Base event entity for academy activities. Training sessions and matches extend this entity through one-to-one relationships.'

  id uuid [pk, default: `gen_random_uuid()`]
  title varchar [not null]
  event_type varchar [not null]
  start_time timestamptz [not null]
  end_time timestamptz
  location varchar
  team_id uuid
  created_by uuid
  description text
  created_at timestamptz [not null, default: `now()`]
}


Table bookings {
  Note: 'Associates people with events. Tracks booking status and attendance/check-in information.'

  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  person_id uuid [not null]
  booking_status varchar [default: 'Booked']
  attendance_status varchar
  checked_in_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table training_sessions {
  Note: 'Training-specific information linked to an event.'

  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  coach_id uuid
  training_theme varchar
  training_plan text
  created_at timestamptz [not null, default: `now()`]
}


Table matches {
  Note: 'Match-specific information linked to an event.'

  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  opponent varchar
  competition varchar
  home_away varchar
  result varchar
  score_for integer
  score_against integer
  created_at timestamptz [not null, default: `now()`]
}


Table match_players {
  Note: 'Records player involvement and statistics for matches.'

  id uuid [pk, default: `gen_random_uuid()`]
  match_id uuid [not null]
  person_id uuid [not null]
  starting_position varchar
  was_starter boolean [default: false]
  minutes_played integer
  goals integer [default: 0]
  assists integer [default: 0]
  yellow_cards integer [default: 0]
  red_cards integer [default: 0]
  created_at timestamptz [not null, default: `now()`]
}


Ref: events.team_id > teams.id
Ref: events.created_by > persons.id
Ref: bookings.event_id > events.id
Ref: bookings.person_id > persons.id
Ref: training_sessions.event_id > events.id
Ref: training_sessions.coach_id > persons.id
Ref: matches.event_id > events.id
Ref: match_players.match_id > matches.id
Ref: match_players.person_id > persons.id


Table match_events {
  Note: 'Records events occurring during a match, optionally associated with a player.'

  id uuid [pk, default: `gen_random_uuid()`]
  match_id uuid [not null]
  person_id uuid
  event_type varchar [not null]
  minute integer
  description text
  created_at timestamptz [not null, default: `now()`]
}


Table tournaments {
  Note: 'Represents an organised tournament competition.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  location varchar
  start_date date
  end_date date
  organiser varchar
  created_at timestamptz [not null, default: `now()`]
}


Table tournament_teams {
  Note: 'Associates teams with tournaments. A team may participate in many tournaments and a tournament may contain many teams.'

  tournament_id uuid [not null]
  team_id uuid [not null]
  indexes {
    (tournament_id, team_id) [pk]
  }
}


Table facilities {
  Note: 'Represents physical academy facilities or venues.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  facility_type varchar [not null]
  location varchar
  capacity integer
  is_active boolean [not null, default: true]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table pitches {
  Note: 'Represents playable areas within a facility.'

  id uuid [pk, default: `gen_random_uuid()`]
  facility_id uuid
  name varchar [not null]
  surface_type varchar
  pitch_size varchar
  lighting_available boolean [default: false]
  is_active boolean [not null, default: true]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table facility_bookings {
  Note: 'Records facility reservations, optionally linked to academy events.'

  id uuid [pk, default: `gen_random_uuid()`]
  facility_id uuid [not null]
  event_id uuid
  booked_by uuid
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  booking_type varchar [not null]
  status varchar [not null, default: 'Confirmed']
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Ref: match_events.match_id > matches.id
Ref: match_events.person_id > persons.id
Ref: tournament_teams.tournament_id > tournaments.id
Ref: tournament_teams.team_id > teams.id
Ref: pitches.facility_id > facilities.id
Ref: facility_bookings.facility_id > facilities.id
Ref: facility_bookings.event_id > events.id
Ref: facility_bookings.booked_by > persons.id


Table pitch_bookings {
  Note: 'Records bookings for individual pitches. Supports both event-linked and standalone reservations.'

  id uuid [pk, default: `gen_random_uuid()`]
  pitch_id uuid [not null]
  event_id uuid
  booked_by uuid
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  booking_type varchar [not null]
  status varchar [not null, default: 'Confirmed']
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table gym_equipment {
  Note: 'Represents gym equipment owned by or located within a facility.'

  id uuid [pk, default: `gen_random_uuid()`]
  facility_id uuid
  name varchar [not null]
  equipment_type varchar
  manufacturer varchar
  model varchar
  serial_number varchar
  purchase_date date
  condition varchar [default: 'Good']
  service_due date
  is_active boolean [not null, default: true]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table gym_programs {
  Note: 'Defines reusable gym or strength and conditioning programs.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  description text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}


Table gym_sessions {
  Note: 'Records an individual gym session completed by a person, optionally linked to a program and academy event.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  program_id uuid
  event_id uuid
  coach_id uuid
  start_time timestamptz [not null]
  end_time timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table gym_session_equipment {
  Note: 'Associates equipment used during a gym session.'

  gym_session_id uuid [not null]
  equipment_id uuid [not null]
  usage_notes text
  indexes {
    (gym_session_id, equipment_id) [pk]
  }
}


Table membership_types {
  Note: 'Defines available membership plans.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  description text
  amount numeric
  duration_months integer
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}


Table memberships {
  Note: 'Assigns membership plans to people over a defined period.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  membership_type_id uuid
  start_date date [not null]
  end_date date
  status varchar [not null, default: 'Active']
  created_at timestamptz [not null, default: `now()`]
}


Table invoices {
  Note: 'Represents invoices issued to people for academy services or memberships.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  invoice_number varchar [unique]
  description text
  amount numeric [not null]
  due_date date
  status varchar [not null, default: 'Outstanding']
  issued_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}


Ref: pitch_bookings.pitch_id > pitches.id
Ref: pitch_bookings.event_id > events.id
Ref: pitch_bookings.booked_by > persons.id
Ref: gym_equipment.facility_id > facilities.id
Ref: gym_programs.created_by > persons.id
Ref: gym_sessions.person_id > persons.id
Ref: gym_sessions.program_id > gym_programs.id
Ref: gym_sessions.event_id > events.id
Ref: gym_sessions.coach_id > persons.id
Ref: gym_session_equipment.gym_session_id > gym_sessions.id
Ref: gym_session_equipment.equipment_id > gym_equipment.id
Ref: memberships.person_id > persons.id
Ref: memberships.membership_type_id > membership_types.id
Ref: invoices.person_id > persons.id


Table payments {
  Note: 'Records payments made by people, optionally applied against an invoice.'

  id uuid [pk, default: `gen_random_uuid()`]
  invoice_id uuid
  person_id uuid [not null]
  amount numeric [not null]
  payment_method varchar
  payment_reference varchar
  paid_at timestamptz
  status varchar [default: 'Completed']
  created_at timestamptz [not null, default: `now()`]
}


Table discounts {
  Note: 'Stores discounts that may be applied to a person's account.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid
  discount_type varchar
  amount numeric
  percentage numeric
  reason text
  valid_from date
  valid_to date
  created_at timestamptz [not null, default: `now()`]
}


Table refunds {
  Note: 'Records refunds issued against payments.'

  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  amount numeric [not null]
  reason text
  refunded_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}


Table communications {
  Note: 'Represents outbound communications such as email, SMS or notifications.'

  id uuid [pk, default: `gen_random_uuid()`]
  sender_id uuid
  communication_type varchar [not null]
  subject varchar
  body text
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}


Table communication_recipients {
  Note: 'Tracks recipients and delivery status for communications.'

  id uuid [pk, default: `gen_random_uuid()`]
  communication_id uuid [not null]
  person_id uuid [not null]
  contact_id bigint
  delivery_status varchar
  delivered_at timestamptz
  opened_at timestamptz
}


Table notification_preferences {
  Note: 'Stores a person's communication and marketing preferences.'

  person_id uuid [pk, not null]
  email_enabled boolean [default: true]
  sms_enabled boolean [default: true]
  marketing_enabled boolean [default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table document_types {
  Note: 'Defines categories of documents managed by the academy.'

  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  description text
  expiry_required boolean [default: false]
}


Table documents {
  Note: 'Stores documents uploaded for people, together with verification and expiry information.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  document_type_id uuid
  storage_path text
  uploaded_by uuid
  verified boolean [default: false]
  expiry_date date
  created_at timestamptz [not null, default: `now()`]
}


Ref: payments.invoice_id > invoices.id
Ref: payments.person_id > persons.id
Ref: discounts.person_id > persons.id
Ref: refunds.payment_id > payments.id
Ref: communications.sender_id > persons.id
Ref: communication_recipients.communication_id > communications.id
Ref: communication_recipients.person_id > persons.id
Ref: communication_recipients.contact_id > contacts.id
Ref: notification_preferences.person_id > persons.id
Ref: documents.person_id > persons.id
Ref: documents.document_type_id > document_types.id
Ref: documents.uploaded_by > persons.id


Table consent_records {
  Note: 'Maintains a historical record of consent decisions for people.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid [not null]
  consent_type varchar [not null]
  granted boolean [not null]
  granted_by uuid
  granted_at timestamptz
  withdrawn_at timestamptz
  version varchar
  created_at timestamptz [not null, default: `now()`]
}


Table identity_verification_events {
  Note: 'Records identity verification activities performed for people.'

  id uuid [pk, default: `gen_random_uuid()`]
  person_id uuid
  verification_type varchar
  performed_by uuid
  outcome varchar
  notes text
  created_at timestamptz [not null, default: `now()`]
}


Table audit_log {
  Note: 'Records changes made to database records for auditing purposes.'

  id bigint [pk]
  table_name varchar [not null]
  record_id uuid
  action varchar [not null]
  changed_by uuid
  old_values jsonb
  new_values jsonb
  created_at timestamptz [not null, default: `now()`]
}


Table legacy_import_batches {
  Note: 'Represents a batch import from a legacy system.'

  id uuid [pk, default: `gen_random_uuid()`]
  source_system varchar [not null]
  imported_at timestamptz [not null, default: `now()`]
  imported_by uuid
  notes text
}


Table legacy_person_records {
  Note: 'Stores imported person records from legacy systems prior to reconciliation.'

  id uuid [pk, default: `gen_random_uuid()`]
  import_batch_id uuid
  source_system varchar
  source_record_id varchar
  raw_data jsonb
  match_status varchar [default: 'Unreviewed']
  matched_person_id uuid
  created_at timestamptz [not null, default: `now()`]
}


Table legacy_relationship_records {
  Note: 'Stores imported relationship records awaiting reconciliation.'

  id uuid [pk, default: `gen_random_uuid()`]
  import_batch_id uuid
  source_system varchar
  raw_data jsonb
  match_status varchar [default: 'Unreviewed']
  created_at timestamptz [not null, default: `now()`]
}


Table legacy_identity_matches {
  Note: 'Tracks the matching of legacy person records to academy person records.'

  id uuid [pk, default: `gen_random_uuid()`]
  legacy_record_id uuid [not null]
  person_id uuid
  confidence varchar
  confirmed_by uuid
  confirmed_at timestamptz
  notes text
}


Ref: consent_records.person_id > persons.id
Ref: consent_records.granted_by > persons.id
Ref: identity_verification_events.person_id > persons.id
Ref: identity_verification_events.performed_by > persons.id
Ref: audit_log.changed_by > persons.id
Ref: legacy_import_batches.imported_by > persons.id
Ref: legacy_person_records.import_batch_id > legacy_import_batches.id
Ref: legacy_person_records.matched_person_id > persons.id
Ref: legacy_relationship_records.import_batch_id > legacy_import_batches.id
Ref: legacy_identity_matches.legacy_record_id > legacy_person_records.id
Ref: legacy_identity_matches.person_id > persons.id
Ref: legacy_identity_matches.confirmed_by > persons.id